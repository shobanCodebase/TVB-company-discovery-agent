# --- LLM ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1

# --- Search ---
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# --- Email verification ---
HUNTER_API_KEY=
USE_EMAIL_VERIFICATION_API=true

# --- Pipeline tuning ---
TARGET_QUALIFIED_LEADS=20
MIN_QUALIFIED_LEADS=15
MAX_DISCOVERY_QUERIES=25
MAX_CANDIDATES_PER_QUERY=8
MAX_CANDIDATES_TOTAL=150
MAX_RESEARCH_ITERATIONS=60
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=2

# --- Financial range ---
MIN_AMOUNT_USD=1000000
MAX_AMOUNT_USD=5000000

# --- Misc ---
ENABLE_CACHE=true

LLM_EXTRACTION_MAX_TOKENS=900
LLM_QUERY_GEN_MAX_TOKENS=300
RESEARCH_MAX_SOURCE_CHARS=5000
MAX_CANDIDATES_FOR_RESEARCH=20
GROQ_MIN_REQUEST_INTERVAL_SECONDS=20
